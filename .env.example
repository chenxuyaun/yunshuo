DATABASE_URL=postgres://yunshuo:yunshuo@localhost:5433/yunshuo
# 开发默认只监听 127.0.0.1。容器内需设为 0.0.0.0，并让反向代理转发到该端口。
# API_HOST=127.0.0.1
API_PORT=3100
# 位于反向代理之后时设为 1，Fastify 才会信任 X-Forwarded-For 中的客户端 IP。
# TRUST_PROXY=0
SESSION_SECRET=dev-only-change-me
# 模型服务商 API Key 的加密主密钥。生产必须设置独立值，且不能与 SESSION_SECRET 相同；
# 缺失或相同时 API 与 worker 会拒绝启动。开发环境未设置时回退到 SESSION_SECRET，界面会显式提示。
# 轮换后已保存的 API Key 需要重新录入。
# MODEL_KEY_SECRET=
WEB_ORIGIN=http://localhost:5173
DEV_AUTH=1

# M5-A 本地账号：邀请注册密码至少 10 位，服务端只存 scrypt 哈希，不存明文。
# 种子用户没有默认密码；DEV_AUTH 仅限本机，生产必须关闭并设置 SESSION_SECRET。
# 邀请链接一次性使用；创建邀请时会尝试投递邮件，同时仍返回可复制的接受链接。
# 生产环境缺少 SESSION_SECRET 时 API 会拒绝启动；Secure Cookie 由 NODE_ENV=production 决定。
# 登录限流是单进程内存（8 次失败/10 分钟/邮箱+IP），重启清空，多实例不共享。

# M5-B OIDC/SSO：一个部署只接一个 OIDC Provider；本地密码登录始终保留。
# 三项必填同时出现才启用，缺项会在启动时报错。生产环境 issuer 与回调地址必须 HTTPS。
# 回调地址需与 IdP 控制台登记值完全一致，例如：
# OIDC_ISSUER=https://idp.example.com/realms/yunshuo
# OIDC_CLIENT_ID=yunshuo
# OIDC_CLIENT_SECRET=...            只放环境变量或密钥管理，不写数据库
# OIDC_REDIRECT_URI=https://yunshuo.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=企业 SSO
# 首次登录按“已验证邮箱”绑定现有本地账号；sub 绑定后不再随邮箱变化。
# OIDC_AUTO_PROVISION=1 时，无本地账号但存在待接受邀请的身份会自动开通并接受邀请；
# 默认 0，意味着必须先有本地账号或邀请。登录只接受非对称签名的 ID Token（拒绝 HS*）。
# 不保存 ID Token、access token、授权码或客户端密钥；退出只清本地会话，IdP 会话需在 IdP 侧退出。

# M5-B 邮件投递与密码重置：
# MAIL_MODE=smtp    通过 SMTP 真实发送（需配置下方变量）
# MAIL_MODE=memory  开发内存邮箱，只在本机进程内可读，不会真实投递（非生产默认）
# MAIL_MODE=off     不发送，界面如实显示“未配置”，邀请链接仍需手动复制
# 生产默认 off；生产显式设为 memory 会拒绝启动。
# 邮件正文、邀请令牌与重置令牌不写入数据库，mail_messages 只保留投递元数据。
# 密码重置链接 30 分钟有效、只能使用一次；同一账号同时最多一个未使用令牌。
# MAIL_MODE=memory
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=0
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=云说 <no-reply@example.com>
# DEV_AUTH=1 且 MAIL_MODE=memory 时，GET /api/dev/mailbox 可读取开发内存邮箱（仅本机）。

# M4-B 无人值守 runner：默认随 API 进程启动，每 2 秒轮询一次。
# 设为 0 可关闭；关闭时作业会停在“排队中”。
# API 重启会中断正在执行的章节，作业需人工恢复。
# AUTOMATION_RUNNER=0
# AUTOMATION_POLL_MS=2000

# 自动备份尚未接入；无人值守作业启动前手动执行：
# bash scripts/backup-db.sh
# dump 写入 backups/（已 gitignore），可用以下变量覆盖默认容器/用户/库/目录：
# YUNSHUO_DB_CONTAINER=yunshuo-db
# YUNSHUO_DB_USER=yunshuo
# YUNSHUO_DB_NAME=yunshuo
# YUNSHUO_BACKUP_DIR=backups

# Studio 单机部署不使用本文件，而是读取 .env.studio（模板见 .env.studio.example）：
#   cp .env.studio.example .env.studio
#   docker compose --env-file .env.studio -f docker-compose.studio.yml up -d --build
# 详见 docs/云说-Studio部署说明.md。

# 集成测试请另建 yunshuo_test 库并显式传入 DATABASE_URL，
# 不要让测试作业与开发 runner 共用主库：
# docker exec yunshuo-db createdb -U yunshuo yunshuo_test
# DATABASE_URL=postgres://yunshuo:yunshuo@localhost:5433/yunshuo_test pnpm db:migrate
# DATABASE_URL=postgres://yunshuo:yunshuo@localhost:5433/yunshuo_test pnpm db:seed
# DATABASE_URL=postgres://yunshuo:yunshuo@localhost:5433/yunshuo_test pnpm test

# 模型与嵌入服务商不在环境变量中配置：
# 登录后在页头“模型服务商”登记 OpenAI 兼容端点，用途选择 chat 或 embedding。
# 嵌入服务商需支持 POST {baseUrl}/embeddings；未配置时索引保持“未配置”，检索只跑词法。
# 向量通道最低余弦相似度（0–1）。低于该值的向量邻居会被丢弃；
# 最高分仍低于阈值时整条向量通道弃用，检索降级为词法并说明原因。
# 默认 0.4 来自本机 Ollama bge-m3 的最初 13 条查询；它只过滤极低相似度噪声，
# 不能判断问题是否有答案：近域/混合负例和部分纯语义改写会落在同一分数区间。
# 换模型/换语料需重新评估，不要把它当成通用答案性阈值。
# SEARCH_VECTOR_MIN_SCORE=0.4
