# 云说 Studio 单机部署环境变量示例。
# 复制为 .env.studio 后填写；该文件已被 gitignore，不要提交真实密钥。
# 启动：
#   docker compose --env-file .env.studio -f docker-compose.studio.yml up -d --build
# 说明见 docs/云说-Studio部署说明.md。

# 对外访问端口与公开地址。PUBLIC_ORIGIN 必须与浏览器实际访问的协议/主机/端口一致。
STUDIO_HTTP_PORT=8088
STUDIO_PUBLIC_ORIGIN=http://localhost:8088

# 数据库密码只用于容器内网连接。请使用 URL 安全字符（字母数字与 - _ .）。
# 修改该值不会改变已有数据卷中的密码。
STUDIO_DB_PASSWORD=

# 会话签名密钥与模型 API Key 加密主密钥，必须分别是随机长字符串。
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
STUDIO_SESSION_SECRET=
STUDIO_MODEL_KEY_SECRET=

# 首个所有者初始化（bootstrap 每次启动都会执行）：
# - 邮箱不存在：创建账号、工作区和所有者成员关系；
# - 邮箱已是某工作区所有者：跳过，不修改密码；
# - 邮箱存在但不是所有者：只警告并跳过，不修改角色。
# 修改这些值不会重置已有账号密码。
# 密码只在“需要新建所有者”时校验；首次部署必须填写至少 10 位，
# 之后可以清空，bootstrap 仍会以非零退出码报告其他初始化错误。
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=所有者
BOOTSTRAP_WORKSPACE_NAME=云说工作区

# 邮件：off 不发送（界面显示未配置）；smtp 真实发送。
# 邀请与密码重置仍可在界面复制一次性链接。
STUDIO_MAIL_MODE=off
# STUDIO_MAIL_HOST=smtp.example.com
# STUDIO_MAIL_PORT=587
# STUDIO_MAIL_SECURE=0
# STUDIO_MAIL_USER=
# STUDIO_MAIL_PASSWORD=
# STUDIO_MAIL_FROM=云说 <no-reply@example.com>

# OIDC/SSO（可选）。三项必填同时出现才启用。
# 回调地址必须登记在 IdP，例如 https://yunshuo.example.com/api/auth/oidc/callback
# STUDIO_OIDC_ISSUER=
# STUDIO_OIDC_CLIENT_ID=
# STUDIO_OIDC_CLIENT_SECRET=
# STUDIO_OIDC_REDIRECT_URI=
# STUDIO_OIDC_SCOPES=openid email profile
# STUDIO_OIDC_PROVIDER_NAME=企业 SSO
# STUDIO_OIDC_AUTO_PROVISION=0

# 无人值守 runner 随 API 进程运行，默认开启；作业仍需先创建授权。
STUDIO_AUTOMATION_RUNNER=1
STUDIO_AUTOMATION_POLL_MS=2000
STUDIO_LOG_LEVEL=info
